# Puerto local (WhatXia Basic). next dev / next start deben usar 3002.
# Túneles locales (cloudflared / ngrok) deben apuntar a http://localhost:3002
PORT=3002

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth web (recuperación de contraseña / redirectTo)
# Debe coincidir con Redirect URLs en Supabase Dashboard → Authentication
# Ej. local: http://localhost:3002
# Incluir también: http://localhost:3002/auth/confirm
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# USER-001 / CFG-001 / BOT-001 — Programa Pioneros
# Fuente de verdad: tabla launch_programs (code=PIONEERS_USERS, is_active).
# Se administra desde el panel Ops. Este env YA NO se usa; se ignora en runtime.
# PRE_LAUNCH_MODE=true

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Voz → texto (Whisper). Solo capa WhatsApp; Mobility no lo usa.
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_WHISPER_LANGUAGE=es
VOICE_TRANSCRIPTION_PROVIDER=openai_whisper

# Cron (gestión documental diaria)
CRON_SECRET=

# Google Maps (Places New, Geocoding, Routes) — solo servidor
GOOGLE_MAPS_API_KEY=

# Bias de ciudad (fallback). Fuente de verdad: tabla cities (migración 017).
# Ciudad activa actual: Ibagué.
GEO_CITY_LAT=4.4389
GEO_CITY_LNG=-75.2322
GEO_CITY_RADIUS_M=18000
PLACE_CONFIDENCE_THRESHOLD=0.75

# Tarifas WhatXia: tabla Supabase fare_rules (por city_id).

# REF-005 — Programa de referidos (100% WhatsApp)
# Enlace a compartir: https://wa.me/573193455555?text=REF%20DRV-XXXXX
# Por defecto se usa el número oficial 573193455555 si no se define:
WHATSAPP_BUSINESS_PHONE=573193455555
NEXT_PUBLIC_WHATSAPP_PHONE=
# Landing /r/[code] solo compatibilidad (no usar para compartir nuevos referidos)
REFERRAL_PUBLIC_BASE_URL=
